{
  "name": "harborbrowser",
  "displayName": "Harbor Browser",
  "description": "Browse Harbor container registry projects, repositories and artifacts, and copy image references or pull commands without leaving the editor.",
  "version": "1.1.0",
  "publisher": "raulmouzo",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0B3D5C",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raulmouzo/harborbrowser.git"
  },
  "bugs": {
    "url": "https://github.com/raulmouzo/harborbrowser/issues"
  },
  "homepage": "https://github.com/raulmouzo/harborbrowser#readme",
  "keywords": [
    "harbor",
    "goharbor",
    "docker",
    "container",
    "registry",
    "container registry",
    "image",
    "oci",
    "helm",
    "kubernetes"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "harborbrowser.login",
        "title": "Connect to Registry…",
        "category": "Harbor Browser",
        "icon": "$(plug)"
      },
      {
        "command": "harborbrowser.logout",
        "title": "Disconnect",
        "category": "Harbor Browser",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "harborbrowser.refresh",
        "title": "Refresh",
        "category": "Harbor Browser",
        "icon": "$(refresh)"
      },
      {
        "command": "harborbrowser.copyImageName",
        "title": "Copy Image Reference",
        "category": "Harbor Browser",
        "icon": "$(copy)"
      },
      {
        "command": "harborbrowser.copyPullCommand",
        "title": "Copy Pull Command",
        "category": "Harbor Browser",
        "icon": "$(terminal)"
      },
      {
        "command": "harborbrowser.showVulnerabilities",
        "title": "Show Vulnerability Report",
        "category": "Harbor Browser",
        "icon": "$(shield)"
      },
      {
        "command": "harborbrowser.openInBrowser",
        "title": "Open in Harbor",
        "category": "Harbor Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "harborbrowser.showLogs",
        "title": "Show Logs",
        "category": "Harbor Browser",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harborbrowser",
          "title": "Harbor Browser",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "harborbrowser": [
        {
          "id": "harborbrowser.projects",
          "name": "Projects",
          "icon": "resources/activitybar.svg",
          "contextualTitle": "Harbor Browser"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "harborbrowser.projects",
        "contents": "Browse the projects, repositories and artifacts of a [Harbor](https://goharbor.io) container registry.\n[Connect to Registry](command:harborbrowser.login)\nSign in with a user account, an OIDC CLI secret or a robot account, or browse public projects anonymously. Read the [getting started guide](https://github.com/raulmouzo/harborbrowser#getting-started) for details.",
        "when": "!harborbrowser.connected"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harborbrowser.refresh",
          "when": "view == harborbrowser.projects && harborbrowser.connected",
          "group": "navigation@1"
        },
        {
          "command": "harborbrowser.login",
          "when": "view == harborbrowser.projects",
          "group": "connection@1"
        },
        {
          "command": "harborbrowser.logout",
          "when": "view == harborbrowser.projects && harborbrowser.connected",
          "group": "connection@2"
        },
        {
          "command": "harborbrowser.showLogs",
          "when": "view == harborbrowser.projects",
          "group": "troubleshooting@1"
        }
      ],
      "view/item/context": [
        {
          "command": "harborbrowser.copyImageName",
          "when": "view == harborbrowser.projects && viewItem =~ /^artifact/",
          "group": "inline@1"
        },
        {
          "command": "harborbrowser.openInBrowser",
          "when": "view == harborbrowser.projects && viewItem =~ /^(project|repository|artifact)/",
          "group": "inline@2"
        },
        {
          "command": "harborbrowser.copyImageName",
          "when": "view == harborbrowser.projects && viewItem =~ /^artifact/",
          "group": "1_copy@1"
        },
        {
          "command": "harborbrowser.copyPullCommand",
          "when": "view == harborbrowser.projects && viewItem =~ /^artifact:pullable/",
          "group": "1_copy@2"
        },
        {
          "command": "harborbrowser.openInBrowser",
          "when": "view == harborbrowser.projects && viewItem =~ /^(project|repository|artifact)/",
          "group": "2_open@1"
        },
        {
          "command": "harborbrowser.showVulnerabilities",
          "when": "view == harborbrowser.projects && viewItem =~ /^artifact.*:scanned$/",
          "group": "3_security@1"
        }
      ],
      "commandPalette": [
        {
          "command": "harborbrowser.logout",
          "when": "harborbrowser.connected"
        },
        {
          "command": "harborbrowser.refresh",
          "when": "harborbrowser.connected"
        },
        {
          "command": "harborbrowser.copyImageName",
          "when": "false"
        },
        {
          "command": "harborbrowser.copyPullCommand",
          "when": "false"
        },
        {
          "command": "harborbrowser.openInBrowser",
          "when": "false"
        },
        {
          "command": "harborbrowser.showVulnerabilities",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "pnpm run \"/^watch:/\"",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package-vsix": "vsce package --no-dependencies",
    "publish-openvsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "ovsx": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  }
}
