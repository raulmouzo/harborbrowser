{
  "name": "harborbrowser",
  "displayName": "HarborBrowser",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "harborbrowser.login",
        "title": "Harbor Browser: Login"
      },
      {
        "command": "harborbrowser.logout",
        "title": "Harbor Browser: Clear Credentials"
      },
      {
        "command": "harborbrowser.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "harborbrowser.copyImageName",
        "title": "Copy Image Name",
        "icon": "$(copy)"
      },
      {
        "command": "harborbrowser.copyPullCommand",
        "title": "Copy Pull Command"
      },
      {
        "command": "harborbrowser.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harborbrowser",
          "title": "Harbor Browser",
          "icon": "harborbrowser.svg"
        }
      ]
    },
    "views": {
      "harborbrowser": [
        {
          "id": "harborbrowser.projects",
          "name": "Projects"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "harborbrowser.refresh",
          "when": "view == harborbrowser.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "harborbrowser.copyImageName",
          "when": "view == harborbrowser.projects && viewItem == artifact",
          "group": "inline@1"
        },
        {
          "command": "harborbrowser.copyImageName",
          "when": "view == harborbrowser.projects && viewItem == artifact",
          "group": "copy@1"
        },
        {
          "command": "harborbrowser.copyPullCommand",
          "when": "view == harborbrowser.projects && viewItem == artifact",
          "group": "copy@2"
        },
        {
          "command": "harborbrowser.openInBrowser",
          "when": "view == harborbrowser.projects && (viewItem == project || viewItem == repository || viewItem == artifact)",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
